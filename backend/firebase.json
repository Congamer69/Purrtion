{
  "firestore": { "rules": "firestore.rules" },
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "rewrites": [{ "source": "/f/**", "destination": "/f/index.html" }],
    "headers": [{ "source": "**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] }]
  }
}
